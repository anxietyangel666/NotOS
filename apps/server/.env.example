PORT=4000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,file://,null
DATABASE_URL=postgresql://notoc:notoc@localhost:5432/notoc
JWT_SECRET=replace-with-long-random-secret
AUTH_FILE_SECRET=replace-with-long-random-secret
BCRYPT_ROUNDS=12

# Shared Groq API key used by the built-in AI Chat app for every user.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Daily AI request quota per regular user (Dev users are unlimited).
# Keeps each user's daily cost within budget (~0.13 cent/request on the model
# above, so 40 ≈ 5 cents/day). The limit resets once every 24 hours.
AI_DAILY_REQUEST_LIMIT=40
