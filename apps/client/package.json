{
  "name": "@notoc/client",
  "version": "0.5.29",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "pack:win": "npm run build && electron-packager . NotOS --platform=win32 --arch=x64 --out=release-packaged --overwrite --ignore=src --ignore=release --ignore=release-packaged --icon=public/Emoji/app-icon.ico",
    "preview": "vite preview --host 0.0.0.0"
  },
  "build": {
    "appId": "local.notoc.client",
    "productName": "NotOS",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "icon": "public/Emoji/app-icon.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/Emoji/app-icon.ico",
      "artifactName": "NotOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NotOS",
      "installerIcon": "public/Emoji/app-icon.ico",
      "uninstallerIcon": "public/Emoji/app-icon.ico",
      "installerHeaderIcon": "public/Emoji/app-icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "electron": "42.3.3",
    "electron-builder": "^26.15.0",
    "electron-packager": "^17.1.2",
    "wait-on": "^8.0.1"
  }
}
